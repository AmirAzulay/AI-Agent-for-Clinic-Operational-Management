# Copy this file to .env in the same folder. .env is ignored by git and must never be committed.
# Docker Compose reads it automatically; the services read the same names from the environment.

# PostgreSQL (clinic-app)
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
CLINIC_DB_URL=jdbc:postgresql://localhost:5432/clinic
CLINIC_DB_USER=clinic
CLINIC_DB_PASSWORD=clinic

# Elasticsearch (history-service)
ELASTICSEARCH_URIS=http://localhost:9200

# Where clinic-app sends history events
HISTORY_BASE_URL=http://localhost:8081

# JWT signing secret for clinic-app (at least 32 characters). Any random string; keep it private.
JWT_SECRET=clinic-agent-dev-secret-change-me-0123456789abcdef
JWT_TTL=8h

# Needed from phase 4 (AI agent). Leave empty until then; tests and CI never need it.
ANTHROPIC_API_KEY=
